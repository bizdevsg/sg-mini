{
  "name": "sgb-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "concurrently -n website,client-area -c blue,magenta \"npm:dev:website\" \"npm:dev:client-area\"",
    "dev:website": "npm run dev --workspace=@sgb/website",
    "dev:client-area": "npm run dev --workspace=@sgb/client-area",
    "build": "npm run build:website && npm run build:client-area",
    "build:website": "npm run build --workspace=@sgb/website",
    "build:client-area": "npm run build --workspace=@sgb/client-area",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
