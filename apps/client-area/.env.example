APP_ENV=dev
NEXT_PUBLIC_SITE_URL=http://localhost:3009
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_CLIENT_AREA=true
CLIENT_AREA_SESSION_SECRET=
# --- Trade Pilot (server-only; JANGAN diberi prefix NEXT_PUBLIC_) ---
# mock = cookie mock lokal; api = backend SGB-TP /v1/trade-pilot ("live" diterima sebagai alias lama).
TRADE_PILOT_DATA_SOURCE=mock
# Base URL backend tanpa path, mis. http://localhost:5000. Client menambahkan /v1/trade-pilot.
TRADE_PILOT_API_BASE_URL=
# Opsional untuk container jika API berjalan di host, contoh http://host.docker.internal:5000
TRADE_PILOT_DOCKER_API_BASE_URL=
# Harus sama persis dengan TRADE_PILOT_API_KEY di backend SGB-TP. Dikirim sebagai Authorization: Bearer.
TRADE_PILOT_API_KEY=
# Secret HMAC userId (buat dengan: openssl rand -hex 64). Terpisah dari CLIENT_AREA_SESSION_SECRET.
# JANGAN dirotasi tanpa rencana migrasi: semua user akan dianggap user baru.
TRADE_PILOT_USER_ID_SECRET=
# Site key reCAPTCHA v2 khusus login Client Area; fallback ke key umum di bawah.
NEXT_PUBLIC_CLIENT_AREA_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# false hanya mematikan reCAPTCHA saat SGB_FLAVOR=dev; UAT/prod selalu wajib.
CLIENT_AREA_RECAPTCHA_ENABLED=true
# Paksa reCAPTCHA pada localhost saat SGB_FLAVOR=dev.
CLIENT_AREA_RECAPTCHA_ALLOW_LOCAL=false
RECAPTCHA_MIN_SCORE=0.65
NEXT_ALLOWED_ORIGINS=localhost:3009

# Tambahkan konfigurasi API berita, banner, ebook, market, dan image proxy
# dari template root sesuai kebutuhan Client Area.

# --- Integrasi API pihak ketiga (SSO/Trading/Registrasi) — lihat docs/api/ ---
# flavor server pihak ketiga: dev | uat | prod. JANGAN pernah set prod tanpa izin eksplisit.
SGB_FLAVOR=uat
# Passphrase enkripsi password login (CryptoJS AES passphrase mode). Minta nilainya ke tim
# integrasi SGB dan isi hanya di file env server/lokal; jangan pernah di-commit.
SGB_PASSWORD_PASSPHRASE=
# Header perangkat yang dikirim ke setiap request pihak ketiga (nilai simulasi, bukan device asli).
SGB_DEVICE_OS=Client Area
SGB_DEVICE_BRAND_MODEL=Client Area
SGB_DEVICE_MANUFACTURER=Solid Gold Berjangka
SGB_APP_VERSION=1.28.2
SGB_DEFAULT_LATITUDE=-6.175392
SGB_DEFAULT_LONGITUDE=106.827153
SGB_REQUEST_TIMEOUT_MS=20000
# Konfigurasi server-side untuk URL WebView MiniMicro (bukan NEXT_PUBLIC_*).
MM_CHART_VERSION_APP=1.30.10 (259)
MM_CHART_TYPE_DEVICE=Web - ClientArea
# Akun uji untuk scripts/sgb-discovery.ts — HANYA di .env.local, JANGAN commit, JANGAN gunakan flavor prod.
SGB_TEST_EMAIL=
SGB_TEST_PASSWORD=

# Lewati OTP saat login (khusus dev). Hanya aktif kalau APP_ENV=dev, NODE_ENV bukan production, dan SGB_FLAVOR bukan prod.
# Session yang dibuat memakai token dummy, jadi call SGB yang butuh token asli tidak akan jalan.
CLIENT_AREA_SKIP_OTP=false
