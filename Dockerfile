ARG NEXT_PUBLIC_LOGIN_URL
ARG NEXT_PUBLIC_REGISTER_URL
ARG NEXT_PUBLIC_ENABLE_CLIENT_AREA
ARG NEXT_PUBLIC_ENABLE_TAWK_CHAT
ARG NEXT_PUBLIC_HERO_CTA_URL
ARG NEXT_PUBLIC_SPREAD_CTA_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SOLID_GOLD_PLAY_STORE_URL
ARG NEXT_PUBLIC_SOLID_GOLD_APP_STORE_URL
ARG NEXT_PUBLIC_SOLID_GOLD_IMAGE_BASE_URL
ARG NEXT_PUBLIC_RECAPTCHA_SITE_KEY
ARG RECAPTCHA_SECRET_KEY
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
