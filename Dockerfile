ARG NEWS_API_URL_ID
ARG NEWS_API_TOKEN
ARG NEWS_PORTAL_BASE_URL
ARG NEWS_IMAGE_BASE_URL
ARG PRODUCT_API_URL
ARG EBOOK_CATEGORY_API_URL
ARG PRODUCT_PORTAL_BASE_URL
ARG SG_ADMIN_API_KEY
ARG SG_ADMIN_REQUEST_ORIGIN
ARG CLIENT_AREA_CONFIG_API_URL
ARG CLIENT_AREA_CONFIG_API_TOKEN
ARG BANNER_API_URL
ARG BANNER_DETAIL_API_URL
ARG BANNER_IMAGE_BASE_URL
ARG PENGHARGAAN_API_URL
