FROM node:22-bookworm-slim AS base

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS deps

COPY package.json package-lock.json ./
RUN npm ci

FROM base AS builder

ARG APP_ENV=prod
ARG INTERNAL_API_TOKEN
ARG CLIENT_AREA_SESSION_SECRET
ARG LIVE_QUOTE_SOCKET_URL
ARG NEXT_PUBLIC_LIVE_QUOTE_SOCKET_URL
ARG NEXT_PUBLIC_FRAMER_IMAGE_BASE_URL
