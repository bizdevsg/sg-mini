ENV_FILE=.env
APP_ENV=dev
INTERNAL_API_TOKEN=
CLIENT_AREA_SESSION_SECRET=

NEXT_PUBLIC_LIVE_QUOTE_SOCKET_URL=

NEXT_PUBLIC_FRAMER_IMAGE_BASE_URL=
NEWS_API_URL=https://sg-admin.sg-berjangka.com/api/v1/berita
NEWS_API_URL_ID=https://sg-admin.sg-berjangka.com/api/v1/berita
NEWS_PORTAL_BASE_URL=
NEWS_IMAGE_BASE_URL=
PRODUCT_API_URL=
EBOOK_CATEGORY_API_URL=
PRODUCT_PORTAL_BASE_URL=
# X-API-Key untuk endpoint SG Admin, termasuk berita
SG_ADMIN_API_KEY=
SG_ADMIN_REQUEST_ORIGIN=http://localhost:6969
CLIENT_AREA_CONFIG_API_URL=
CLIENT_AREA_CONFIG_API_TOKEN=

# --- Integrasi API pihak ketiga Client Area (SSO/Trading/Registrasi) — lihat docs/api/ ---
# flavor server pihak ketiga: dev | uat | prod. JANGAN pernah set prod tanpa izin eksplisit.
SGB_FLAVOR=uat
# Passphrase enkripsi password login (CryptoJS AES passphrase mode). Minta nilainya ke tim
# integrasi SGB dan isi hanya di file env server/lokal; jangan pernah di-commit.
SGB_PASSWORD_PASSPHRASE=
# Header perangkat yang dikirim ke setiap request pihak ketiga (nilai simulasi, bukan device asli).
SGB_DEVICE_OS=Android / 13
SGB_DEVICE_BRAND_MODEL=Google - Pixel 7
SGB_DEVICE_MANUFACTURER=Google
SGB_APP_VERSION=1.28.2
SGB_DEFAULT_LATITUDE=-6.175392
SGB_DEFAULT_LONGITUDE=106.827153
SGB_REQUEST_TIMEOUT_MS=20000
# SGB_TEST_EMAIL / SGB_TEST_PASSWORD sengaja TIDAK ada di sini — itu hanya untuk
# scripts/sgb-discovery.ts lokal, isi di apps/client-area/.env.local, jangan pernah
# di .env.prod atau file env yang di-commit.

BANNER_API_URL=
BANNER_DETAIL_API_URL=
BANNER_IMAGE_BASE_URL=
PENGHARGAAN_API_URL=
PENGHARGAAN_IMAGE_BASE_URL=
PENGUMUMAN_API_URL=
CONTACT_MESSAGE_API_URL=
COMPANY_PROFILE_API_URL=
LEGALITAS_API_URL=
PRIVACY_POLICY_API_URL=
TERMS_CONDITIONS_API_URL=
HISTORICAL_DATA_API_URL=
HISTORICAL_DATA_API_TOKEN=
ECONOMIC_CALENDAR_API_BASE_URL=
ECONOMIC_CALENDAR_API_TOKEN=
MARKET_ACADEMY_API_URL=https://endpoapi-production-3202.up.railway.app/api/market-academy
TRADINGVIEW_SYMBOL_API_URL=
MARKET_SIGNAL_API_URL=
MARKET_SIGNAL_IMAGE_BASE_URL=
FRANKFURTER_API_URL=

NEXT_PUBLIC_PLACEHODER_BASE_URL=

NEXT_PUBLIC_LOGIN_URL=
NEXT_PUBLIC_REGISTER_URL=
NEXT_PUBLIC_CLIENT_SITE_URL=http://localhost:3009
NEXT_PUBLIC_WEBSITE_URL=http://localhost:6969
NEXT_PUBLIC_ENABLE_CLIENT_AREA=false
NEXT_PUBLIC_ENABLE_TAWK_CHAT=false
NEXT_PUBLIC_HERO_CTA_URL=
NEXT_PUBLIC_SPREAD_CTA_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SOLID_GOLD_PLAY_STORE_URL=
NEXT_PUBLIC_SOLID_GOLD_APP_STORE_URL=
NEXT_PUBLIC_SOLID_GOLD_IMAGE_BASE_URL=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# false = matikan reCAPTCHA hanya di login Client Area (runtime); default aktif
CLIENT_AREA_RECAPTCHA_ENABLED=true
RECAPTCHA_MIN_SCORE=0.65

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
